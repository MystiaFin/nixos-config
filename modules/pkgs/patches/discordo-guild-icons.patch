+
+func TestInitials(t *testing.T) {
+	for name, want := range map[string]string{
+		"Akademi Wengdev": "AW",
+		"r/unixporn":      "r",
+		"  Rust  Lang  ":  "RL",
+		"":                "",
+		"ミク Fan Club":     "ミFC",
+	} {
+		if got := initials(name); got != want {
+			t.Errorf("initials(%q) = %q, want %q", name, got, want)
+		}
+	}
+}
+
+// newRailModel returns a model of the direct messages and two guilds, the second in a folder, each with a channel shown.
+func newRailModel(t *testing.T) (m Model, guilds, channels [2]*tree.Node) {
+	t.Helper()
+	cfg := config.Default()
+	m = NewModel(&cfg, ningen.FromState(state.NewWithStore("", defaultstore.New())))
+	root := m.reset()
+	// Shown, so the direct messages are not loaded.
+	m.dmRootNode.AddChild(tree.NewNode("dm").SetReference(discord.ChannelID(100)))
+
+	folder := tree.NewNode("folder")
+	for index, parent := range []*tree.Node{root, folder} {
+		guilds[index] = tree.NewNode("guild").SetReference(discord.GuildID(index + 1))
+		channels[index] = tree.NewNode("channel").SetReference(discord.ChannelID(index + 1))
+		parent.AddChild(guilds[index].AddChild(channels[index]))
+	}
+	root.AddChild(folder)
+	return m, guilds, channels
+}
+
+func TestModelSwitchAdjacent(t *testing.T) {
+	m, guilds, channels := newRailModel(t)
+	m.switchTo(guilds[0])
+	if m.top() != guilds[0] || m.current != channels[0] {
+		t.Fatalf("top, current = %v, %v, want the first guild and its channel", m.top(), m.current)
+	}
+
+	// The guild in the folder is next, then the direct messages, wrapping around.
+	for _, want := range []*tree.Node{guilds[1], m.dmRootNode, guilds[0]} {
+		m.switchAdjacent(false)
+		if m.top() != want {
+			t.Fatalf("top = %v, want %v", m.top(), want)
+		}
+	}
+
+	m.switchAdjacent(true)
+	if m.top() != m.dmRootNode {
+		t.Errorf("top = %v, want the direct messages", m.top())
+	}
+}
+
+func TestModelSwitchToLastOpened(t *testing.T) {
+	m, guilds, channels := newRailModel(t)
+	second := tree.NewNode("second").SetReference(discord.ChannelID(10))
+	guilds[0].AddChild(second)
+	m.lastOpened[guilds[0]] = second
+
+	m.switchTo(guilds[1])
+	m.switchTo(guilds[0])
+	if m.current != second {
+		t.Errorf("current = %v, want the channel last opened", m.current)
+	}
+
+	// A channel no longer in the tree is not returned to.
+	guilds[1].ClearChildren().AddChild(tree.NewNode("new"))
+	m.lastOpened[guilds[1]] = channels[1]
+	m.switchTo(guilds[1])
+	if m.current != guilds[1].Children()[0] {
+		t.Errorf("current = %v, want the first channel", m.current)
+	}
+}
+
+func TestRailWidgetHandle(t *testing.T) {
+	first, second := tree.NewNode("first"), tree.NewNode("second")
+	w := railWidget{items: []railItem{{node: first}, {node: second}}, iconWidth: 4, iconHeight: 2}
+	area := tview.Rectangle{X: 0, Y: 5, Width: w.width(), Height: 20}
+	for _, test := range []struct {
+		name string
+		y    int
+		want *tree.Node
+	}{
+		{"first icon", 5, first},
+		{"first icon bottom", 6, first},
+		{"spacing", 7, nil},
+		{"second icon", 8, second},
+		{"below", 11, nil},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			click := tview.MouseMsg{EventMouse: tcell.NewEventMouse(1, test.y, tcell.Button1, 0), Action: tview.MouseLeftClick}
+			got, _ := w.Handle(click, area).(railMsg)
+			if got.node != test.want {
+				t.Errorf("node = %v, want %v", got.node, test.want)
+			}
+		})
+	}
+}
