diff --git a/internal/ui/chat/guildstree/rail.go b/internal/ui/chat/guildstree/rail.go
new file mode 100644
index 0000000..139d2d4
--- /dev/null
+++ b/internal/ui/chat/guildstree/rail.go
@@ -0,0 +1,351 @@
+package guildstree
+
+import (
+	"cmp"
+	"strings"
+	"unicode/utf8"
+
+	"github.com/ayn2op/arikawa/v3/discord"
+	"github.com/ayn2op/discordo/internal/ui/images"
+	"github.com/ayn2op/ningen/v3"
+	"github.com/ayn2op/tview"
+	"github.com/ayn2op/tview/cmd"
+	tviewimage "github.com/ayn2op/tview/image"
+	"github.com/ayn2op/tview/layout"
+	"github.com/ayn2op/tview/tree"
+	"github.com/ayn2op/tview/viewport"
+	"github.com/gdamore/tcell/v3"
+	"github.com/gdamore/tcell/v3/color"
+)
+
+// railSpacing is the number of empty rows between the icons of the rail.
+const railSpacing = 1
+
+const (
+	railActiveMarker    = "▌"
+	railUnreadMarker    = "•"
+	railMentionedMarker = "●"
+)
+
+// railMsg shows the channels of node, a guild or the direct messages.
+type railMsg struct {
+	node *tree.Node
+}
+
+// railScrollMsg scrolls the rail to ScrollState.
+type railScrollMsg struct {
+	ScrollState viewport.ScrollState
+}
+
+// railItem is a guild, or the direct messages, shown as an icon in the rail.
+type railItem struct {
+	node *tree.Node
+	// icon is the URL of the image of the guild, or "" if it has none.
+	icon       discord.URL
+	initials   string
+	indication ningen.UnreadIndication
+}
+
+// iconsEnabled reports whether the guilds are shown as a rail of icons beside the channels of one of them.
+func (m Model) iconsEnabled() bool {
+	icons := m.cfg.UI.GuildsTree.Icons
+	return icons.Enabled && icons.Height > 0
+}
+
+// SetIconWidth sets the width in cells of the icons of the rail.
+func (m *Model) SetIconWidth(width int) {
+	m.iconWidth = width
+}
+
+// home returns the node of the guild, or the direct messages, that the current node is in, or nil if it is in none.
+func (m Model) home() *tree.Node {
+	return m.homeOf(m.current)
+}
+
+// homeOf returns the node of the guild, or the direct messages, that node is in, or nil if it is in none.
+func (m Model) homeOf(node *tree.Node) *tree.Node {
+	for _, node := range m.root.PathTo(node) {
+		switch node.Reference().(type) {
+		case discord.GuildID, dmNode:
+			return node
+		}
+	}
+
+	return nil
+}
+
+// top returns the node whose children are shown as the top level of the tree.
+func (m Model) top() *tree.Node {
+	if !m.iconsEnabled() {
+		return m.root
+	}
+
+	return cmp.Or(m.home(), m.dmRootNode)
+}
+
+// railNodes returns the nodes of the direct messages and the guilds, those in folders in place of their folder.
+func (m Model) railNodes() []*tree.Node {
+	var nodes []*tree.Node
+	for _, node := range m.root.Children() {
+		if node.Reference() != nil {
+			nodes = append(nodes, node)
+			continue
+		}
+
+		nodes = append(nodes, node.Children()...)
+	}
+
+	return nodes
+}
+
+func (m Model) railItems() []railItem {
+	nodes := m.railNodes()
+	items := make([]railItem, 0, len(nodes))
+	for _, node := range nodes {
+		item := railItem{node: node}
+		switch ref := node.Reference().(type) {
+		case dmNode:
+			item.initials = "DM"
+			channels, _ := m.state.Cabinet.PrivateChannels()
+			for _, channel := range channels {
+				item.indication = max(item.indication, m.state.ChannelIsUnread(channel.ID, ningen.UnreadOpts{IncludeMutedCategories: true}))
+			}
+		case discord.GuildID:
+			if guild, err := m.state.Cabinet.Guild(ref); err == nil {
+				item.icon = guildIconURL(*guild)
+				item.initials = initials(guild.Name)
+			}
+			item.indication = m.state.GuildIsUnread(ref, ningen.GuildUnreadOpts{IncludeMutedCategories: true})
+		}
+		items = append(items, item)
+	}
+
+	return items
+}
+
+// IconURLs returns the URLs of the icons of the rail, which stay loaded while it is shown.
+func (m Model) IconURLs() map[discord.URL]bool {
+	urls := make(map[discord.URL]bool)
+	if !m.iconsEnabled() {
+		return urls
+	}
+
+	for _, item := range m.railItems() {
+		if item.icon != "" {
+			urls[item.icon] = true
+		}
+	}
+
+	return urls
+}
+
+// requestIcons returns the command that loads the icons of the rail that are not loaded, or nil.
+func (m Model) requestIcons() tview.Cmd {
+	msg := images.RequestedMsg{Squares: map[discord.URL]uint{}}
+	for url := range m.IconURLs() {
+		if _, ok := m.images[url]; !ok {
+			msg.Squares[url] = uint(m.cfg.UI.GuildsTree.Icons.Height)
+		}
+	}
+
+	if len(msg.Squares) == 0 {
+		return nil
+	}
+
+	return cmd.Task(func() tview.Msg { return msg })
+}
+
+// switchTo shows the channels of node, a guild or the direct messages, opening the channel last opened in it.
+func (m *Model) switchTo(node *tree.Node) tview.Cmd {
+	if node == nil {
+		return nil
+	}
+
+	if len(node.Children()) == 0 {
+		m.selectNode(node)
+	}
+	node.Expand()
+
+	m.railScroll.ScrollToTarget()
+	if last := m.lastOpened[node]; last != nil && len(node.PathTo(last)) > 0 {
+		m.expandPathToNode(last)
+		m.setCurrentNode(last)
+		return m.selectNode(last)
+	}
+
+	m.setCurrentNode(cmp.Or(firstChild(node), node))
+	return nil
+}
+
+// switchAdjacent shows the channels of the guild after the one shown, or before it if previous, wrapping around.
+func (m *Model) switchAdjacent(previous bool) tview.Cmd {
+	nodes := m.railNodes()
+	if len(nodes) == 0 {
+		return nil
+	}
+
+	index := 0
+	for i, node := range nodes {
+		if node == m.top() {
+			index = i
+		}
+	}
+
+	step := 1
+	if previous {
+		step = len(nodes) - 1
+	}
+
+	return m.switchTo(nodes[(index+step)%len(nodes)])
+}
+
+func firstChild(node *tree.Node) *tree.Node {
+	if children := node.Children(); len(children) > 0 {
+		return children[0]
+	}
+
+	return nil
+}
+
+func guildIconURL(guild discord.Guild) discord.URL {
+	url := guild.IconURLWithType(discord.PNGImage)
+	if url == "" {
+		return ""
+	}
+
+	return url + "?size=128"
+}
+
+// initials returns the first letter of each word of name, as Discord shows a guild without an icon.
+func initials(name string) string {
+	var initials strings.Builder
+	for _, word := range strings.Fields(name) {
+		r, _ := utf8.DecodeRuneInString(word)
+		initials.WriteRune(r)
+	}
+
+	return initials.String()
+}
+
+// railView returns the rail of icons in a viewport that keeps the icon of the guild shown in view.
+func (m Model) railView() tview.Widget {
+	items := m.railItems()
+	rail := railWidget{items: items, active: -1, images: m.images, iconWidth: m.iconWidth, iconHeight: m.cfg.UI.GuildsTree.Icons.Height}
+	top := m.top()
+	for index, item := range items {
+		if item.node == top {
+			rail.active = index
+		}
+	}
+
+	return viewport.New(rail, m.railScroll).
+		Width(layout.Fixed(rail.width())).
+		Target(rail.target).
+		OnChange(func(s *viewport.ScrollState) tview.Msg { return railScrollMsg{ScrollState: *s} })
+}
+
+// railWidget draws the icons of the guilds one under another, each after a marker of whether it is shown or unread.
+type railWidget struct {
+	items  []railItem
+	active int
+	images map[discord.URL]tviewimage.Widget
+
+	iconWidth, iconHeight int
+}
+
+var _ tview.Widget = railWidget{}
+
+// width returns the width of the marker, the icon, and the space after it.
+func (w railWidget) width() int {
+	return 1 + w.iconWidth + 1
+}
+
+func (w railWidget) step() int {
+	return w.iconHeight + railSpacing
+}
+
+func (w railWidget) height() int {
+	return max(len(w.items)*w.step()-railSpacing, 0)
+}
+
+// target returns the rows of the icon of the guild shown.
+func (w railWidget) target(int) (top, height int) {
+	if w.active < 0 {
+		return 0, 0
+	}
+
+	return w.active * w.step(), w.iconHeight
+}
+
+func (w railWidget) Size() (width, height layout.Length) {
+	return layout.Fixed(w.width()), layout.Fixed(w.height())
+}
+
+func (w railWidget) Layout(limits layout.Limits) layout.Size {
+	width, height := w.Size()
+	return layout.Atomic(limits, width, height)
+}
+
+func (w railWidget) Draw(screen tview.Screen, area tview.Rectangle) {
+	for index, item := range w.items {
+		y := area.Y + index*w.step()
+		w.drawMarker(screen, item, index == w.active, area.X, y)
+
+		icon := tview.Rectangle{X: area.X + 1, Y: y, Width: w.iconWidth, Height: w.iconHeight}
+		if image, ok := w.images[item.icon]; ok && item.icon != "" {
+			if width, _ := image.Size(); width != layout.Fixed(0) {
+				image.Draw(screen, icon)
+				continue
+			}
+		}
+
+		drawInitials(screen, item.initials, icon)
+	}
+}
+
+// drawMarker draws, left of the icon of item at y, a bar if it is shown, or a dot if it is unread.
+func (w railWidget) drawMarker(screen tview.Screen, item railItem, active bool, x, y int) {
+	style := tcell.StyleDefault
+	switch {
+	case active:
+		for row := range w.iconHeight {
+			screen.Put(x, y+row, railActiveMarker, style)
+		}
+	case item.indication == ningen.ChannelMentioned:
+		screen.Put(x, y+(w.iconHeight-1)/2, railMentionedMarker, style.Foreground(color.Red))
+	case item.indication == ningen.ChannelUnread:
+		screen.Put(x, y+(w.iconHeight-1)/2, railUnreadMarker, style)
+	}
+}
+
+// drawInitials fills area and writes initials in the middle of it.
+func drawInitials(screen tview.Screen, initials string, area tview.Rectangle) {
+	style := tcell.StyleDefault.Reverse(true)
+	for y := range area.Height {
+		for x := range area.Width {
+			screen.Put(area.X+x, area.Y+y, " ", style)
+		}
+	}
+
+	tview.Print(screen, initials, area.X, area.Y+(area.Height-1)/2, area.Width, tview.HorizontalAlignmentCenter, style.Bold(true))
+}
+
+// Handle turns a click on an icon into the message that shows the channels of its guild.
+func (w railWidget) Handle(msg tview.Msg, area tview.Rectangle) tview.Msg {
+	mouse, ok := msg.(tview.MouseMsg)
+	if !ok || mouse.Action != tview.MouseLeftClick {
+		return msg
+	}
+
+	x, y := mouse.Position()
+	if !area.Contains(x, y) {
+		return msg
+	}
+
+	row := y - area.Y
+	if index := row / w.step(); index < len(w.items) && row%w.step() < w.iconHeight {
+		return railMsg{node: w.items[index].node}
+	}
+
+	return nil
+}
